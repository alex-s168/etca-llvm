define i64 @caller_5args_64() {
; QW-LABEL: caller_5args_64:
; QW:       store %r{{[0-9]+}}q, %r6
; QW:       call sum5_64
  %r = call i64 @sum5_64(i64 1, i64 2, i64 3, i64 4, i64 5)
