; GN-NEXT:  push %r4
; GN-NEXT:  movz %r3, %r1
; GN-NEXT:  movz %r4, %r2
; GN-NEXT:  call ext_callee
; GN-NEXT:  add %r0, %r3
; GN-NEXT:  add %r0, %r4
; GN-NEXT:  movz %r6, %r5
; GN-NEXT:  sub %r6, 4
; GN-NEXT:  pop %r4
; GN-NEXT:  pop %r3
; GN-NEXT:  pop %r5
; GN-NEXT:  jmpr %r7
;
; EW-LABEL: normal_func:
; EW:       push %r5
; EW-NEXT:  movz %r5, %r6
; EW-NEXT:  push %r3
; EW-NEXT:  push %r4
; EW-NEXT:  movz %r3, %r1d
; EW-NEXT:  movz %r4, %r2d
; EW-NEXT:  call ext_callee
; EW-NEXT:  add %r0, %r3
; EW-NEXT:  add %r0, %r4
; EW-NEXT:  movz %r6, %r5
; EW-NEXT:  sub %r6, 8
; EW-NEXT:  pop %r4
; EW-NEXT:  pop %r3
; EW-NEXT:  pop %r5
; EW-NEXT:  jmpr %r7
;
; QW-LABEL: normal_func:
; QW:       push %r5
; QW-NEXT:  movz %r5, %r6
; QW-NEXT:  call ext_callee
; QW-NEXT:  add %r0, %r1
; QW-NEXT:  add %r0, %r2
; QW-NEXT:  movz %r6, %r5
; QW-NEXT:  pop %r5
; QW-NEXT:  jmpr %r7
;
; P64-LABEL: normal_func:
