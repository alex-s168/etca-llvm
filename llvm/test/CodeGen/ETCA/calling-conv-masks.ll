; REX-NEXT:  pop %r14
; REX-NEXT:  pop %r13
; REX-NEXT:  pop %r5
; REX-NEXT:  jmpr %r7
  %r1 = call i16 @ext_callee(i16 %v0)
  %r2 = add i16 %r1, %v1
