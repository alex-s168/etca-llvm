;; --- Call from within a function that has params too (register reuse) ---

declare i16 @transform(i16)

define i16 @chain_call(i16 %x) {
; GN-LABEL: chain_call:
; GN:       call transform
; GN:       jmpr %r7
;
; DW-LABEL: chain_call:
; DW:       call transform
; DW:       jmpr %r7
;
; QW-LABEL: chain_call:
; QW:       call transform
; QW:       jmpr %r7
  %r = call i16 @transform(i16 %x)
  ret i16 %r
}

