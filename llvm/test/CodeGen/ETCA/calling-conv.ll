;; --- Recursive call (exercises caller-save / stack) ---

define i16 @simple_recursion(i16 %n) {
; GN-LABEL: simple_recursion:
; GN:       cmp %r0, %r1
; GN:       beq
; GN:       br
; GN:       sub %r0, 1
; GN:       call simple_recursion
; GN:       jmpr %r7
;
; DW-LABEL: simple_recursion:
; DW:       cmp %r0, %r1
; DW:       beq
; DW:       br
; DW:       sub %r0, 1
; DW:       call simple_recursion
; DW:       jmpr %r7
;
; QW-LABEL: simple_recursion:
; QW:       cmp %r0, %r1
; QW:       beq
; QW:       br
; QW:       sub %r0, 1
; QW:       call simple_recursion
; QW:       jmpr %r7
  %cmp = icmp eq i16 %n, 0
  br i1 %cmp, label %base, label %recurse
base:
  ret i16 0
recurse:
  %nm1 = sub i16 %n, 1
  %r = call i16 @simple_recursion(i16 %nm1)
  ret i16 %r
}

;; --- Mutual recursion (declaration only) ---

declare i16 @even(i16)

define i16 @odd(i16 %n) {
; GN-LABEL: odd:
; GN:       cmp %r0, %r1
; GN:       beq
; GN:       sub %r0, 1
; GN:       call even
; GN:       jmpr %r7
;
; DW-LABEL: odd:
; DW:       cmp %r0, %r1
; DW:       beq
; DW:       sub %r0, 1
; DW:       call even
; DW:       jmpr %r7
;
; QW-LABEL: odd:
; QW:       cmp %r0, %r1
; QW:       beq
; QW:       sub %r0, 1
; QW:       call even
; QW:       jmpr %r7
  %cmp = icmp eq i16 %n, 0
  br i1 %cmp, label %base, label %recurse
base:
  ret i16 0
recurse:
  %nm1 = sub i16 %n, 1
  %r = call i16 @even(i16 %nm1)
  ret i16 %r
}
