;; ===========================================================================
;; ETCA calling-convention codegen tests
;;
;; Tests function calls, argument passing, and return values.  The ETCA
;; calling convention assigns:
;;   - First four i16 arguments to r0-r3
;;   - Remaining arguments on the stack (2-byte aligned)
;;   - Return value in r0 (i16) or r0-r1 pair (i32)
;;
;; Instructions covered:
;;   CALL_Pseudo → call, RET_Pseudo → ret,
;;   argument setup via registers and stack.
;;
;; Check-prefixes:
;;   GN = generic 16-bit word (base ISA)
;;   DW = 32-bit word (+dw)
;;   QW = 64-bit word (+qw)
;; ===========================================================================

;; --- No-argument call ---

declare i16 @callee_noarg()

define i16 @caller_noarg() {
; GN-LABEL: caller_noarg:
; GN:       call callee_noarg
; GN:       jmpr %r7
;
; DW-LABEL: caller_noarg:
; DW:       call callee_noarg
; DW:       jmpr %r7
;
; QW-LABEL: caller_noarg:
; QW:       call callee_noarg
; QW:       jmpr %r7
  %r = call i16 @callee_noarg()
  ret i16 %r
}

;; --- One-argument call ---

declare i16 @callee1(i16)

define i16 @caller_one_arg(i16 %x) {
; GN-LABEL: caller_one_arg:
; GN:       call callee1
; GN:       jmpr %r7
;
; DW-LABEL: caller_one_arg:
; DW:       call callee1
; DW:       jmpr %r7
;
; QW-LABEL: caller_one_arg:
; QW:       call callee1
; QW:       jmpr %r7
  %r = call i16 @callee1(i16 %x)
  ret i16 %r
}

